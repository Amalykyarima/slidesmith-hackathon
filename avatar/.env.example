# LiveKit project (the hackathon pass page has these; never commit real values)
LIVEKIT_URL=wss://<your-project>.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Synthesia workspace API key with Interactive Avatars
SYNTHESIA_API_KEY=

# The avatar's brain (Claude). Haiku keeps spoken replies fast.
ANTHROPIC_API_KEY=
AVATAR_LLM_MODEL=claude-haiku-5-5

# Where SlideSmith's API is, and the shared secret (same as AVATAR_SECRET in backend/.env)
SLIDESMITH_URL=http://localhost:8000
AVATAR_SECRET=

# Optional
# SYNTHESIA_AVATAR_ID=7572faa9-15da-400d-8227-ef1ab8932523   # Kenji (default)
# CARTESIA_VOICE_ID=b134c304-d095-4d2b-a77a-914f5e8e84e7   # Sterling (male, matches Kenji)
# AVATAR_AGENT_NAME=slidesmith-avatar
