# Get a key at https://console.anthropic.com. Leave empty to run in MOCK mode (no AI, good for UI testing).
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# Optional: path to LibreOffice's soffice binary (used only for slide previews).
# Windows e.g. C:\Program Files\LibreOffice\program\soffice.exe
# macOS   e.g. /Applications/LibreOffice.app/Contents/MacOS/soffice
SOFFICE_BIN=

CORS_ORIGINS=http://localhost:4200
