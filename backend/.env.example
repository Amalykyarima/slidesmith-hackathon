# Get a key at https://console.anthropic.com. Leave empty to run in MOCK mode (no AI, good for UI testing).
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# Optional: path to LibreOffice's soffice binary (used only for slide previews).
# Windows e.g. C:\Program Files\LibreOffice\program\soffice.exe
# macOS   e.g. /Applications/LibreOffice.app/Contents/MacOS/soffice
SOFFICE_BIN=

CORS_ORIGINS=http://localhost:4200

# Hosting only (see docs/HOSTING.md). Leave empty locally.
ACCESS_CODES=
SECRET_KEY=
PREVIEW_MAX_SLIDES=0
AI_DAILY_LIMIT=0

# Live avatar (optional). LiveKit keys from the hackathon pass or cloud.livekit.io. AVATAR_SECRET: any long
# random string, the same in avatar/.env. Never commit real values.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
AVATAR_SECRET=
